% Publications source file.
%
% Paste BibTeX entries exported from Google Scholar (or arXiv, MathSciNet,
% etc.) below. Each entry can optionally carry two extra custom fields
% that plain BibTeX ignores but this site's build script reads:
%
%   tags = {Fukaya categories, mirror symmetry}   % comma-separated
%   pdf  = {https://arxiv.org/pdf/2401.01234}     % direct link to a PDF
%
% After editing this file, regenerate data/publications.json with:
%   python3 scripts/build_publications.py
% (the GitHub Actions deploy workflow does this automatically on every
% build, so you never need to commit publications.json by hand).
%
% Example entry (delete once you have real entries):
%
% @article{example2024,
%   title   = {An Example Paper Title},
%   author  = {Zhou, Peng and Coauthor, Some},
%   journal = {arXiv preprint arXiv:2401.01234},
%   year    = {2024},
%   tags    = {example},
% }
